PAY_TO=0xYourKiteWalletAddress
KITE_NETWORK=testnet
UPSTREAM_URL=https://api.frankfurter.dev

# Tiered pricing (USD). Frankfurter is free, so the split reflects value:
#   PRICE_USD       -> latest + single historical day (cheap)
#   PRICE_USD_RANGE -> time series (date range, larger payload, premium)
#   CONVERT_PRICE_USD -> server-computed conversion endpoint (premium)
PRICE_USD=0.001
PRICE_USD_RANGE=0.01
CONVERT_PRICE_USD=0.01

# Per-client rate limit on paid calls (requests/min). 0 disables.
RATE_LIMIT_PER_MIN=10

SERVICE_DESCRIPTION=Frankfurter exchange rates + computed conversion (latest cross-rates for 30+ currencies) for the Kite network
PORT=8080
